    "        cv_auc_score.append(roc_auc_score(y_val,y_pred))\n",
    "        print('For n_estimators {0}, max_depth {1} cross validation AUC score {2}'.\n",
    "              format(i,j,roc_auc_score(y_val,y_pred)))"

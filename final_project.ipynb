    },
    "id": "Eefm2MI4japc",
    "outputId": "73927d1a-92c8-49f0-d1e9-7291b9ac26fc"
   },
   "outputs": [],
   "source": [
    "#Dropping correlation of variable with the variable itself\n",
    "indexName = strong_pairs.loc[strong_pairs['var1']==strong_pairs['var2']].index\n",
    "strong_pairs.drop(indexName,inplace=True)\n",
    "strong_pairs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "1yJgdd58AIU-"
   },
   "outputs": [],
   "source": [
    "idx = 1\n",
    "row_list=[]\n",
    "while idx<len(strong_pairs):\n",
    "    if strong_pairs.loc[idx,'var1']==strong_pairs.loc[(idx-1),'var2']:\n",
    "        row_list.append(idx)\n",
    "    idx+=1\n",
    "strong_pairs.drop(row_list,inplace=True)"
   ]
  },

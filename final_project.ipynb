   "source": [
    "null = train.isnull().sum()\n",
    "null_df = pd.DataFrame(null, columns=['null_count'])\n",
    "null_df['null percentage'] = null_df['null_count']/len(train)*100\n",
    "null_df.sort_values(by ='null percentage',ascending=False)"
   ]

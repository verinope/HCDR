   "source": [
    "#Make correlation matrix between variables\n",
    "corrMatrix = train_final.corr()\n",
    "corrMatrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",

   "source": [
    "plt.figure(figsize=(20,12))\n",
    "sns.heatmap(corrMatrix)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "9Vd3p_9MNlj-"
   },
   "source": [
    "Labels of correlation strength from https://www.bmj.com/about-bmj/resources-readers/publications/statistics-square-one/11-correlation-and-regression:\n",
    "\n",
    "* 0 - 0.19:  very weak\n",
    "* 0.2 - 0.39 : weak\n",
    "* 0.40 - 0.59: moderate \n",
    "* 0.6 - 0.79 : strong \n",
    "* 0.8 - 1 : very strong"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 1000
    },
    "id": "2dl4tIkv9EFV",
    "outputId": "6aa605e1-8dcc-4d46-f404-a4cca249492c"
   },
   "outputs": [],
   "source": [
    "#Unstack the correlation matrix and filter correlation value >= 0.6\n",
    "corr_pairs = corrMatrix.unstack()\n",
    "sorted_pairs = corr_pairs.sort_values()\n",
    "strong_pairs = sorted_pairs[abs(sorted_pairs) >= 0.6]\n",
    "pd.set_option(\"max_rows\", None)\n",
    "strong_pairs =pd.DataFrame(strong_pairs).reset_index()\n",
    "strong_pairs.columns=['var1','var2','corr']\n",
    "strong_pairs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "6mKgpSahYpqK"
   },
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
